# Public companion to the blog: include only the source files listed below.
# Everything else stays local, including reports, figures, plots, checkpoints,
# traces, raw measurements, archives, environments, logs and operational scripts.
# Add new public source files explicitly rather than publishing generated output.
/*

# Repository documentation and dependencies.
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-base.txt
!/requirements-modern.txt

# Model, training, export and numerical validation.
!/model.py
!/train.py
!/export.py
!/validate.py
!/cross_version.py
!/deep_models.py

# CPU benchmarking, input storage and resource measurement.
!/benchmark.py
!/paired.py
!/pipeline.py
!/pipeline_deep.py
!/preprocessing.py
!/measurement.py
!/runtime_setup.py
!/environment.py
!/deep_attention.py
!/deep_memory.py
!/deep_model_controls.py
!/deep_quota.py
!/native_path_study.py

# CPU experiment drivers. Remote setup and report generators remain local.
!/run_remote.py
!/run_deep.py
!/run_allocator.py
!/run_full_allocator.py
!/run_native_path.py
!/run_native_alloc_controls.py

# GPU experiments: keep the benchmark harnesses and custom kernels only.
!/gpu_experiments/
/gpu_experiments/*
!/gpu_experiments/gpu_suite.py
!/gpu_experiments/gpu_followup.py
!/gpu_experiments/fused_ffn.py
!/gpu_experiments/fusion_case.py
!/gpu_experiments/run_fusion.py
!/gpu_experiments/run_full_ffn.py
!/gpu_experiments/pair_fusion.py
!/gpu_experiments/kernel_metadata.py
!/gpu_experiments/tensorrt_backend.py
!/gpu_experiments/tensorrt_case.py
!/gpu_experiments/run_tensorrt.py
# Shared support for the optional backend in tensorrt_case.py.
!/gpu_experiments/onnxruntime_backend.py

# Keep figures out even if another directory is made public later.
*.png
*.svg
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
*.eps
*.tif
*.tiff
*.bmp
*.avif
