# Public companion to the blog. Everything is local unless listed below.
# This excludes reports, figures, plots, checkpoints, traces, archives,
# environments, logs, operational scripts and historical report generators.
# Add new public source files explicitly.
/*

!/.gitignore
!/README.md

# autoencoder
!/autoencoder/
/autoencoder/*
!/autoencoder/__init__.py
!/autoencoder/cross_version.py
!/autoencoder/deep_models.py
!/autoencoder/environment.py
!/autoencoder/export.py
!/autoencoder/measurement.py
!/autoencoder/model.py
!/autoencoder/runtime_setup.py
!/autoencoder/train.py
!/autoencoder/validate.py

# cpu
!/cpu/
/cpu/*
!/cpu/__init__.py
!/cpu/benchmark.py
!/cpu/deep_attention.py
!/cpu/deep_memory.py
!/cpu/deep_model_controls.py
!/cpu/deep_quota.py
!/cpu/native_path_study.py
!/cpu/paired.py
!/cpu/pipeline.py
!/cpu/pipeline_deep.py
!/cpu/preprocessing.py
!/cpu/run_allocator.py
!/cpu/run_deep.py
!/cpu/run_full_allocator.py
!/cpu/run_native_alloc_controls.py
!/cpu/run_native_path.py
!/cpu/run_remote.py

# gpu
!/gpu/
/gpu/*
!/gpu/__init__.py
!/gpu/fused_ffn.py
!/gpu/fusion_case.py
!/gpu/gpu_followup.py
!/gpu/gpu_suite.py
!/gpu/kernel_metadata.py
!/gpu/profile_ffn.py
!/gpu/profile_pipeline.py
!/gpu/collect_profiles.py
!/gpu/analyze_profiles.py
!/gpu/onnxruntime_backend.py
!/gpu/pair_fusion.py
!/gpu/run_full_ffn.py
!/gpu/run_fusion.py
!/gpu/run_tensorrt.py
!/gpu/tensorrt_backend.py
!/gpu/tensorrt_case.py

# requirements
!/requirements/
/requirements/*
!/requirements/requirements-base.txt
!/requirements/requirements-modern.txt
!/requirements/requirements.txt

# Keep figures out even if another directory is made public later.
*.png
*.svg
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
*.eps
*.tif
*.tiff
*.bmp
*.avif
